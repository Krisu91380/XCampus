# CampusConnect Environment Configuration
# Copy this file to .env.local and populate the secrets

# Application
NEXT_PUBLIC_APP_NAME="CampusConnect"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_TAGLINE="Your Campus. Your People."

# Database Connection (PostgreSQL or SQLite)
# For PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For SQLite (local dev): file:./dev.db
DATABASE_URL="file:./dev.db"

# Authentication Secrets
JWT_SECRET="super-secret-jwt-key-change-this-in-production-min-32-chars-long"

# Razorpay Test Mode Credentials
# Get your test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"

# Feature Flags
# If true, allows simulated sandbox payments in dev when Razorpay keys are not yet configured.
# Real mode verifies signatures cryptographically with Razorpay HMAC-SHA256.
ENABLE_SANDBOX_PAYMENTS="true"

# Initial Super Admin (automatically seeded)
ADMIN_INITIAL_EMAIL="admin@campusconnect.edu"
ADMIN_INITIAL_PASSWORD="AdminSecurePassword123!"
