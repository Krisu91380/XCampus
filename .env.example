# CampusConnect Environment Configuration
# Copy this file to .env.local and populate the secrets

# Application
NEXT_PUBLIC_APP_NAME="CampusConnect"
NEXT_PUBLIC_APP_URL="https://x-campus.vercel.app"
NEXT_PUBLIC_APP_TAGLINE="Your Campus. Your People."

# Database Connection (PostgreSQL or SQLite)
# For PostgreSQL (Neon/Supabase/Vercel Postgres): postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# For SQLite (local dev): file:./dev.db
DATABASE_URL="file:./dev.db"

# Authentication Secrets (generate with `openssl rand -hex 32`)
JWT_SECRET="super-secret-jwt-key-change-this-in-production-min-32-chars-long"

# Razorpay Payment Gateway Credentials (Optional if using Admin QR Code payments)
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"

# Feature Flags
ENABLE_SANDBOX_PAYMENTS="false"

# Initial Super Admin (automatically seeded on first startup)
ADMIN_INITIAL_EMAIL="admin@campusconnect.edu"
ADMIN_INITIAL_PASSWORD="AdminSecurePassword123!"

# WebRTC STUN / TURN Configuration (Network Traversal)
# Default public Google STUN servers are built-in automatically.
# Optional: Provide a TURN server (e.g., Metered.ca, Twilio, Coturn) for users behind restrictive symmetric NATs / firewalls.
NEXT_PUBLIC_STUN_SERVER_URL="stun:stun.l.google.com:19302"
NEXT_PUBLIC_TURN_SERVER_URL="turn:global.relay.metered.ca:80"
NEXT_PUBLIC_TURN_USERNAME="openrelayproject"
NEXT_PUBLIC_TURN_CREDENTIAL="openrelayproject"
